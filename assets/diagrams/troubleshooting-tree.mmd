flowchart TD
    Start["SDK 不工作？"] --> InitCheck{"初始化返回值<br/>是否为 0？"}

    InitCheck -->|"返回 -40"| ConfigErr["配置错误"]
    ConfigErr --> ConfigFix["检查 AccessKey 是否正确<br/>检查 EdgeAddresses 是否填写"]

    InitCheck -->|"返回 -100"| InternalErr["内部错误"]
    InternalErr --> InternalFix["检查设备存储权限<br/>检查网络连接"]

    InitCheck -->|"返回 -21"| AlreadyInit["重复初始化"]
    AlreadyInit --> AlreadyFix["确保只调用一次 initialize<br/>使用单例模式"]

    InitCheck -->|"返回 0 (成功)"| APICheck{"调用代理 API<br/>是否成功？"}

    APICheck -->|"返回 -20"| NotInit["SDK 未初始化"]
    NotInit --> NotInitFix["检查初始化时序<br/>确保 initialize 在 API 调用前完成"]

    APICheck -->|"返回 -2"| ArgErr["参数错误"]
    ArgErr --> ArgFix["检查 host 是否为空<br/>检查 port 范围 1-65535"]

    APICheck -->|"成功获取代理地址"| ConnCheck{"连接代理地址<br/>是否成功？"}

    ConnCheck -->|"连接超时"| NetworkErr["网络问题"]
    NetworkErr --> NetworkFix["检查设备网络连接<br/>检查 Edge 节点可达性<br/>检查防火墙规则"]

    ConnCheck -->|"连接成功<br/>但数据异常"| DNSCheck{"DNS 解析<br/>是否正常？"}

    DNSCheck -->|"解析为空"| DNSErr["DNS 配置问题"]
    DNSErr --> DNSFix["检查域名是否在 edgedoh_resolve_domains<br/>检查是否被 edgedoh_bypass_domains 豁免<br/>确认 fallback=true（默认开启）"]

    DNSCheck -->|"解析正常"| Advanced["查看 SDK 日志<br/>联系技术支持"]

    ConnCheck -->|"连接成功<br/>业务正常"| OK["SDK 工作正常"]

    style Start fill:#DC143C,stroke:#B22222,color:#fff
    style InitCheck fill:#FFD700,stroke:#DAA520,color:#333
    style APICheck fill:#FFD700,stroke:#DAA520,color:#333
    style ConnCheck fill:#FFD700,stroke:#DAA520,color:#333
    style DNSCheck fill:#FFD700,stroke:#DAA520,color:#333
    style OK fill:#3CB371,stroke:#2E8B57,color:#fff
    style ConfigFix fill:#F0F0F0,stroke:#CCC,color:#333
    style InternalFix fill:#F0F0F0,stroke:#CCC,color:#333
    style AlreadyFix fill:#F0F0F0,stroke:#CCC,color:#333
    style NotInitFix fill:#F0F0F0,stroke:#CCC,color:#333
    style ArgFix fill:#F0F0F0,stroke:#CCC,color:#333
    style NetworkFix fill:#F0F0F0,stroke:#CCC,color:#333
    style DNSFix fill:#F0F0F0,stroke:#CCC,color:#333
